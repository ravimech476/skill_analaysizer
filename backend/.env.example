APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/skills_analyzer?sslmode=disable
AUTO_MIGRATE=true

JWT_SECRET=generate-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_AFTER=60s
# Returns the OTP in the API response + logs it. Development only.
OTP_DEBUG=true

# React Web (Vite) on port 5180, Flutter Web on port 5190
CORS_ORIGINS=http://localhost:5180,http://localhost:5190

# First admin, created only when no admin exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Administrator
ADMIN_MOBILE=9876543210

# Mobile push (needs real device tokens from the app). Off in development.
PUSH_ENABLED=false

# Name printed on mark statements (PDF)
COLLEGE_NAME=Skills Analyzer College

# Uploaded files (photos, documents…) are stored here
FILES_DIR=storage
