# Copy to deploy/.env on the server and fill in every CHANGE_ME. Never commit the real file.

# ---- site ----
# Your domain (DNS A record → this server). Caddy gets a Let's Encrypt certificate for it.
# Use :80 to test locally over plain HTTP.
SITE_ADDRESS=placements.your-college.edu
APP_VERSION=1.0.0
TZ=Asia/Kolkata
# Extra origins allowed to call the API (the site itself is same-origin). Comma separated.
# CORS_ORIGINS=https://placements.your-college.edu

# ---- database ----
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ---- security ----
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_AFTER=60s
OTP_DEBUG=false
# Per client IP per minute. Campus Wi-Fi shares one IP across many users, so keep these generous.
RATE_LIMIT_PER_MINUTE=3000
AUTH_RATE_LIMIT_PER_MINUTE=120

# ---- first admin (created only when no admin exists) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Administrator
ADMIN_MOBILE=

# ---- OTP by SMS: msg91 | twilio | webhook ----
SMS_PROVIDER=msg91
SMS_COUNTRY_CODE=91
# MSG91: DLT-approved OTP template in a Flow; variables ##otp## and ##minutes##
MSG91_AUTH_KEY=CHANGE_ME
MSG91_TEMPLATE_ID=CHANGE_ME
# Twilio (if SMS_PROVIDER=twilio): TWILIO_FROM is a number or a Messaging Service SID (MG…)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Your own relay (if SMS_PROVIDER=webhook): receives {"to","message","otp","minutes"}
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=

# ---- mobile push (Expo) ----
PUSH_ENABLED=true

# ---- branding ----
COLLEGE_NAME=Your College Name

# ---- backups ----
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14
